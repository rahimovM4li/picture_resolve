# Öffentliche kanonische Adresse; Testsysteme sperren die Indexierung.
SITE_URL=https://pictureresolve.com
ENABLE_INDEXING=false
CMS_DATA_DIR=.local/picture-resolve
# Lokales Mailpit. Für Produktion SMTP-Konto und bestätigte Adressen konfigurieren.
SMTP_HOST=127.0.0.1
SMTP_PORT=4125
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
INQUIRY_FROM=website@pictureresolve.test
INQUIRY_TO=studio@pictureresolve.test
# Optional: eigener persistenter Ordner und am Reverse-Proxy überschriebener Client-IP-Header.
# INQUIRY_DATA_DIR=
# INQUIRY_CLIENT_IP_HEADER=x-real-ip
